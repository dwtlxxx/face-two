# Normalize line endings: LF stored in the repo, native on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF so they run in cmd/PowerShell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Keep lockfiles out of language stats and merge noise.
package-lock.json -diff linguist-generated
pnpm-lock.yaml -diff linguist-generated
yarn.lock -diff linguist-generated
